{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tarangson Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "languages": [
    { "language": "th", "default": true },
    { "language": "en", "prefix": "en" }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Tarangson",
          "icon": "calendar-days",
          "href": "https://tarangson.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "คู่มือผู้ใช้",
        "groups": [
          {
            "group": "เริ่มต้นใช้งาน",
            "pages": [
              "index",
              "getting-started/register",
              "getting-started/setup-wizard",
              "getting-started/dashboard"
            ]
          },
          {
            "group": "ตั้งค่าพื้นฐาน",
            "pages": [
              "settings/academic-defaults",
              "settings/school-profile",
              "settings/account"
            ]
          },
          {
            "group": "จัดการข้อมูล",
            "pages": [
              "roster/teachers",
              "roster/students",
              "roster/rooms",
              "roster/subjects",
              "roster/excel"
            ]
          },
          {
            "group": "สร้างตารางสอน",
            "pages": [
              "timetable/create-file",
              "timetable/wizard",
              "timetable/editing",
              "timetable/viewing",
              "timetable/printing",
              "timetable/files"
            ]
          }
        ]
      },
      {
        "tab": "Developer Guide",
        "hidden": true,
        "groups": [
          {
            "group": "Architecture",
            "pages": [
              "dev/overview",
              "dev/setup"
            ]
          },
          {
            "group": "Data Model",
            "pages": [
              "dev/firestore-schema",
              "dev/types"
            ]
          },
          {
            "group": "Core Modules",
            "pages": [
              "dev/auth",
              "dev/firestore-functions",
              "dev/timetable-engine",
              "dev/excel"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              "dev/contributing"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_horizontal1.svg",
    "dark": "/images/logo_horizontal_fordarkbg.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tarangson.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "เข้าใช้งาน",
      "href": "https://tarangson.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "strict": false,
    "default": "light"
  },
  "fonts": {
    "family": "kanit",
    "weight": 300,
    "source": "https://fonts.google.com/share?selection.family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900",
    "format": "woff"
  }
}
