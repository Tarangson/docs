{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tarangson Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "languages": [
    { "language": "th", "default": true }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Tarangson",
          "icon": "calendar-days",
          "href": "https://tarangson.com"
        }
      ]
    },
    "tabs": [
      {
        "tab": "คู่มือผู้ใช้",
        "groups": [
          {
            "group": "เริ่มต้นใช้งาน",
            "pages": [
              "index",
              "getting-started/register",
              "getting-started/setup-wizard",
              "getting-started/dashboard"
            ]
          },
          {
            "group": "แพ็กเกจ",
            "pages": [
              "pricing"
            ]
          },
          {
            "group": "ตั้งค่าพื้นฐาน",
            "pages": [
              "settings/academic-defaults",
              "settings/school-profile",
              "settings/account"
            ]
          },
          {
            "group": "จัดการข้อมูล",
            "pages": [
              "roster/teachers",
              "roster/students",
              "roster/rooms",
              "roster/subjects",
              "roster/excel"
            ]
          },
          {
            "group": "สร้างตารางสอน",
            "pages": [
              "timetable/create-file",
              "timetable/wizard",
              "timetable/editing",
              "timetable/viewing",
              "timetable/printing",
              "timetable/files"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo_horizontal1.svg",
    "dark": "/images/logo_horizontal_fordarkbg.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tarangson.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "เข้าใช้งาน",
      "href": "https://tarangson.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "appearance": {
    "strict": false,
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Chakra Petch",
      "weight": 500,
      "source": "https://fonts.gstatic.com/s/chakrapetch/v13/cIflMapbsEk7TDLdtEz1BwkebIl1U5_F_gUk0wzH.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Chakra Petch",
      "weight": 300,
      "source": "https://fonts.gstatic.com/s/chakrapetch/v13/cIflMapbsEk7TDLdtEz1BwkeNIh1U5_F_gUk0wzH.woff2",
      "format": "woff2"
    }
  }
}
